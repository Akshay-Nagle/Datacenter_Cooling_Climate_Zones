!-   ===========  ALL OBJECTS IN CLASS: ENERGYMANAGEMENTSYSTEM:PROGRAMCALLINGMANAGER ===========

EnergyManagementSystem:ProgramCallingManager,
    Comprehensive_EMS_Manager,  !- Name
    BeginTimestepBeforePredictor,  !- EnergyPlus Model Calling Point
    Cooling_Stage_Controller;!- Program Name 2


!-   ===========  ALL OBJECTS IN CLASS: ENERGYMANAGEMENTSYSTEM:PROGRAM ===========

EnergyManagementSystem:Program,
    Cooling_Stage_Controller,        !- Name
    IF OA_Temp < -50,                 !- Program Line 1
        SET IEC_Override = 0,         !- Program Line 2
        SET DEC_Override = 0,         !- Program Line 3
        SET CW_Coil_Override = 0,      !- Program Line 4
    ELSEIF OA_Temp > 60,              !- Program Line 5
        SET IEC_Override = 0,         !- Program Line 6
        SET DEC_Override = 0,         !- Program Line 7
        SET CW_Coil_Override = 1,      !- Program Line 8
    ELSEIF OA_Temp < 18.9,            !- Program Line 9
        SET IEC_Override = 0,         !- Program Line 10
        SET DEC_Override = 0,         !- Program Line 11
        SET CW_Coil_Override = 0,      !- Program Line 12
    ELSEIF OA_Temp < 22,              !- Program Line 13
        IF OA_WetBulb < 16,           !- Program Line 14
            SET IEC_Override = 1,     !- Program Line 15
            SET DEC_Override = 0,     !- Program Line 16
            SET CW_Coil_Override = 0,  !- Program Line 17
        ELSE,                        !- Program Line 18
            SET IEC_Override = 1,     !- Program Line 19
            SET DEC_Override = 0,     !- Program Line 20
            SET CW_Coil_Override = 1,  !- Program Line 21
        ENDIF,                       !- Program Line 22
    ELSEIF OA_Temp < 27,              !- Program Line 23
        IF OA_WetBulb < 20,           !- Program Line 24
            SET IEC_Override = 1,     !- Program Line 25
            SET DEC_Override = 1,     !- Program Line 26
            SET CW_Coil_Override = 0,  !- Program Line 27
        ELSE,                        !- Program Line 28
            SET IEC_Override = 1,     !- Program Line 29
            SET DEC_Override = 1,     !- Program Line 30
            SET CW_Coil_Override = 1,  !- Program Line 31
        ENDIF,                       !- Program Line 32
    ELSE,                            !- Program Line 33
        SET IEC_Override = 1,         !- Program Line 34
        SET DEC_Override = 1,         !- Program Line 35
        IF Supply_Air_Temp_After_DEC > 19.5, !- Program Line 36
            SET CW_Coil_Override = 1,  !- Program Line 37
        ELSE,                        !- Program Line 38
            SET CW_Coil_Override = 0,  !- Program Line 39
        ENDIF,                       !- Program Line 40
    ENDIF;                           !- Program Line 41



